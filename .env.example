# GEMINI_API_KEY: Required for Gemini AI analysis reasoning.
# Server-side only. AI Studio or Vercel injects this from environment secrets.
GEMINI_API_KEY=""

# GEMINI_MODEL: Optional model override (default: gemini-3.6-flash).
# Supported models: gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.7-flash
GEMINI_MODEL="gemini-3.6-flash"

# PAGESPEED_API_KEY: Optional PageSpeed Insights API key for performance metrics.
PAGESPEED_API_KEY=""

# SUPABASE_URL: Optional Supabase URL for persistent analysis storage.
SUPABASE_URL=""

# SUPABASE_SERVICE_ROLE_KEY: Optional server-side only key for Supabase persistence. NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=""

# ANALYSIS_TIMEOUT_MS: Hard timeout deadline for the overall analysis pipeline in ms (default: 60000).
ANALYSIS_TIMEOUT_MS=60000

# APP_URL: The URL where this application is hosted (e.g., https://your-deployment-url.app).
APP_URL="http://localhost:3000"
